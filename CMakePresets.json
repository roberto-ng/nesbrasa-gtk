{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gtk-release",
      "displayName": "GTK (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gtk-release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "BUILD_WEB": "OFF",
        "BUILD_GTK": "ON",
        "BUILD_QT": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "qt-debug",
      "displayName": "Qt 6 QtWidgets (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qt-debug",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "BUILD_WEB": "OFF",
        "BUILD_GTK": "OFF",
        "BUILD_QT": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "qt-release",
      "displayName": "Qt 6 QtWidgets (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qt-release",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "BUILD_WEB": "OFF",
        "BUILD_GTK": "OFF",
        "BUILD_QT": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "web-emscripten",
      "displayName": "Web (Emscripten)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web-emscripten",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "environment": {
        "EM_CACHE": "${sourceDir}/frontends/web/.emscripten-cache"
      },
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "BUILD_WEB": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gtk-release",
      "configurePreset": "gtk-release",
      "targets": ["nesbrasa-gtk"]
    },
    {
      "name": "qt-debug",
      "configurePreset": "qt-debug",
      "targets": ["nesbrasa-qt"]
    },
    {
      "name": "qt-release",
      "configurePreset": "qt-release",
      "targets": ["nesbrasa-qt"]
    },
    {
      "name": "web-emscripten",
      "configurePreset": "web-emscripten",
      "targets": ["nesbrasa-web"]
    }
  ]
}
